    {
      "id": "names-formula",
      "name": "POI Names Formula",
      "roll": "1d6",
      "entries": ["(The) [Noun] [POI]", "(The) [Adjective] [POI]", "[POI] of (the) [Noun]", "[Adjective] [POI] of (the) [Noun]", "(The) [Noun] [Adjective] [POI]", "[POI] of (the) [Adjective] [Noun]"]
    },
