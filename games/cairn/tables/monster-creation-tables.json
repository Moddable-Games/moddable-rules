  "usage_note": "Combinator tables for generating a unique monster: roll 1d20 on each column of Monster Appearance, Monster Traits, Monster Attacks, and Monster Abilities, then combine the results and write the creature up in plain English per the 'Creating Monsters' rules page before converting to a stat block.",
  "tables": [
    {
      "id": "monster-appearance-physique",
      "name": "Monster Appearance: Physique",
      "roll": "1d20",
      "entries": [
        "Albino", "Black", "Crystalline", "Emaciated", "Eyeless", "Feathered", "Gelatinous", "Glowing", "Hardened", "Headless",
        "Horned", "Hunched", "Iridescent", "Polyocular", "Scaled", "Segmented", "Skeletal", "Slimy", "Translucent", "Twisted"
      ]
    },
    {
      "id": "monster-appearance-feature",
      "name": "Monster Appearance: Feature",
      "roll": "1d20",
      "entries": [
        "Antennae", "Beak", "Carapace", "Claws", "Fangs", "Feathers", "Fur", "Gilled", "Horns", "Markings",
        "Scales", "Shell", "Snout", "Tail", "Talons", "Tentacles", "Trunk", "Tusks", "Voice", "Wings"
      ]
    },
    {
      "id": "monster-traits-quirks",
      "name": "Monster Traits: Quirks",
      "roll": "1d20",
      "entries": [
        "Alters Its Size at Will", "Changes Color at Will", "Collects Rare Flowers", "Collects Trophies", "Does Not Die of Old Age",
        "Draws Symbols", "Fascinated by Fire", "Hoards Books", "Loves a Specific Color", "Reborn Each Day",
        "Loves Shiny Objects", "Mimics Voices", "Moves in a Straight Line", "Narrates Everything", "Obsessively Cleans",
