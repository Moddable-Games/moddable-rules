{
  "name": "moddable-rules",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node js/build.mjs --all",
    "build:changed": "node js/build.mjs --changed",
    "build:game": "node js/build.mjs --game",
    "index": "node js/build-index.mjs",
    "api": "node js/build-api.mjs",
    "pdf": "node js/pdf.mjs && node scripts/gen-pdf-manifest.mjs",
    "pdf:game": "node js/pdf.mjs --game && node scripts/gen-pdf-manifest.mjs",
    "sync": "node js/sync.mjs",
    "sync:boards": "./scripts/sync-boards.sh",
    "sync:chargen": "./scripts/sync-chargen.sh",
    "og": "python3 build/gen-og.py",
    "check:pdf-release": "node scripts/check-pdf-release.mjs",
    "site": "npm run build && ./scripts/assemble-site.sh",
    "serve": "npm run site && npx --yes serve _site",
    "check:terrain": "node scripts/check-terrain-drawn.mjs",
    "check:gaps": "node scripts/check-gap-declarations.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "puppeteer": "^24.0.0"
  }
}
